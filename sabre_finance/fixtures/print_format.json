  "html": "<div style=\"font-family: Arial; padding: 20px;\">\r\n\r\n    <!-- Header -->\r\n    <div style=\"text-align: center; margin-bottom: 20px;\">\r\n        <h2 style=\"color: #2c3e50;\">Payment Tracking</h2>\r\n        <p style=\"color: #7f8c8d;\">{{ doc.name }} | {{ doc.payment_month }} {{ doc.payment_year }}</p>\r\n    </div>\r\n\r\n    <!-- Payment Info -->\r\n    <div style=\"background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Payment Information</h4>\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\"><b>Agency:</b> {{ doc.agency_name }}</td>\r\n                <td width=\"50%\"><b>Account Manager:</b> {{ doc.account_manager }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Payment Month:</b> {{ doc.payment_month }} {{ doc.payment_year }}</td>\r\n                <td><b>Measure Period:</b> {{ doc.measure_period }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Payment Amount:</b> $ {{ doc.payment_amount }}</td>\r\n                <td><b>Status:</b> {{ doc.workflow_state }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Revision Status -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Revision Status</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr style=\"background: #2c3e50; color: white;\">\r\n                <th style=\"padding: 8px;\">Step</th>\r\n                <th style=\"padding: 8px;\">Status</th>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Market Share</td>\r\n                <td style=\"padding: 8px; text-align: center;\">{{ doc.market_share }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Account Manager Revision</td>\r\n                <td style=\"padding: 8px; text-align: center;\">{{ doc.account_manager_revision }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Ms. Neveen Revision</td>\r\n                <td style=\"padding: 8px; text-align: center;\">{{ doc.ms_neveen_revision }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Customer Claim</td>\r\n                <td style=\"padding: 8px; text-align: center;\">{{ doc.customer_claim }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Bank Transfer</td>\r\n                <td style=\"padding: 8px; text-align: center;\">{{ doc.bank_transfer }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Comments -->\r\n    {% if doc.comments %}\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Comments</h4>\r\n        <p>{{ doc.comments }}</p>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align: center; margin-top: 30px; color: #7f8c8d; font-size: 12px;\">\r\n        <p>Generated by Sabre Finance System</p>\r\n    </div>\r\n\r\n</div>",
