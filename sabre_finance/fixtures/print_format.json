  "font_size": 14,
  "format_data": null,
  "html": "<style>\r\n    @media print {\r\n        @page { size: A4 portrait; margin: 2mm; }\r\n        body { -webkit-print-color-adjust: exact; }\r\n    }\r\n    html, body {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n    .print-format {\r\n        padding-top: 0 !important;\r\n        margin-top: 0 !important;\r\n    }\r\n    .print-body {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 10px;\r\n        color: #2c3e50;\r\n        line-height: 1.0;\r\n    }\r\n    .header-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        border-spacing: 0;\r\n        padding-bottom: 6px;\r\n        margin-bottom: 6px;\r\n        margin-top: 0;\r\n    }\r\n    .header-logo {\r\n        max-height: 80px;\r\n        max-width: 260px;\r\n        object-fit: contain;\r\n        display: block;\r\n        margin-top: -4px;\r\n    }\r\n    .header-title-text h2 {\r\n        margin: 0;\r\n        font-size: 18px;\r\n        color: #2c3e50;\r\n        text-transform: uppercase;\r\n    }\r\n    .header-title-text p {\r\n        margin: 2px 0 0 0;\r\n        color: #7f8c8d;\r\n        font-size: 10px;\r\n    }\r\n    .section-header {\r\n        font-size: 11px;\r\n        font-weight: bold;\r\n        background: #2c3e50;\r\n        color: #ffffff;\r\n        padding: 3px 8px;\r\n        margin-bottom: 3px;\r\n        border-radius: 2px;\r\n        text-transform: uppercase;\r\n        line-height: 1.0;\r\n    }\r\n    .info-table, .data-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 5px;\r\n        line-height: 1.0;\r\n    }\r\n    .info-table td {\r\n        padding: 1px 5px;\r\n        vertical-align: top;\r\n    }\r\n    .data-table th, .data-table td {\r\n        border: 1px solid #cbd5e1;\r\n        padding: 2px 6px;\r\n        text-align: center;\r\n    }\r\n    .data-table th {\r\n        background-color: #f1f5f9;\r\n        font-weight: bold;\r\n        color: #1e293b;\r\n    }\r\n    .text-right { text-align: right !important; }\r\n    .text-left { text-align: left !important; }\r\n    .text-center { text-align: center !important; }\r\n    .bg-total { background-color: #e2e8f0 !important; font-weight: bold; }\r\n    .highlight-row { background-color: #f8fafc; }\r\n\r\n    /* Summary Cards Full Width Grid - 4 Columns */\r\n    .summary-container {\r\n        display: grid;\r\n        grid-template-columns: repeat(5, 1fr);\r\n        gap: 4px;\r\n        width: 100%;\r\n        margin-bottom: 3px;\r\n    }\r\n    .summary-card {\r\n        box-sizing: border-box;\r\n        border: 1px solid #cbd5e1;\r\n        background: #f8fafc;\r\n        border-radius: 3px;\r\n        padding: 3px 8px;\r\n    }\r\n    .summary-card:nth-child(4n) {\r\n        margin-right: 0 !important;\r\n    }\r\n    .summary-card .card-label {\r\n        font-size: 8px;\r\n        color: #64748b;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n    }\r\n    .summary-card .card-value {\r\n        font-size: 11px;\r\n        color: #0f172a;\r\n        font-weight: bold;\r\n        margin-top: 1px;\r\n    }\r\n    /* Vertical Payment Summary Table Styles */\r\n    .payment-summary-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 5px;\r\n        border: 1px solid #cbd5e1;\r\n        line-height: 1.0;\r\n    }\r\n    .payment-summary-table td {\r\n        padding: 2px 10px;\r\n        font-size: 10px;\r\n        border-bottom: 1px solid #e2e8f0;\r\n    }\r\n    .payment-summary-table .label-col {\r\n        color: #334155;\r\n        font-weight: 600;\r\n        text-align: left;\r\n    }\r\n    .payment-summary-table .value-col {\r\n        color: #0f172a;\r\n        font-weight: bold;\r\n        text-align: right;\r\n        font-size: 11px;\r\n    }\r\n    .payment-summary-table .text-danger {\r\n        color: #c0392b !important;\r\n    }\r\n\r\n    /* تمييز الـ Subtotal USD بخلفية زرقاء فاتحة إضافية وإطار محدد */\r\n    .payment-summary-table .subtotal-row td {\r\n        border-top: 1.5px solid #0284c7 !important;\r\n        background-color: #e0f2fe !important;\r\n        font-weight: bold;\r\n    }\r\n    .payment-summary-table .subtotal-row .label-col,\r\n    .payment-summary-table .subtotal-row .value-col {\r\n        color: #0369a1 !important;\r\n        font-size: 11px !important;\r\n    }\r\n\r\n    /* صف الـ Total النهائي */\r\n    .payment-summary-table .total-row td {\r\n        font-size: 12px !important;\r\n        font-weight: bold !important;\r\n        background-color: #2c3e50 !important;\r\n        color: #ffffff !important;\r\n    }\r\n</style>\r\n\r\n<div class=\"print-body\">\r\n\r\n    <!-- Header with Left-Aligned Logo -->\r\n    <table class=\"header-table\" style=\"width: 100%;\">\r\n        <tr>\r\n            <td style=\"text-align: center; vertical-align: middle; padding-bottom: 6px; padding-top: 0;\">\r\n                <img src=\"/files/red sparrow logo.jpg\" class=\"header-logo\" alt=\"Logo\" style=\"margin: 0 auto;\">\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"header-title-text\" style=\"text-align: center; vertical-align: middle;\">\r\n                <h2>Booking Measurement</h2>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Contract Information -->\r\n    <div class=\"section-header\">Contract & Measurement Information</div>\r\n    <table class=\"info-table\" style=\"border: 1px solid #cbd5e1; margin-bottom: 5px;\">\r\n        <tr>\r\n            <td width=\"18%\"><b>Agency Name:</b></td>\r\n            <td width=\"32%\">{{ doc.agency_name or '' }}</td>\r\n            <td width=\"25%\"><b>Contract Ref:</b></td>\r\n            <td width=\"25%\">{{ doc.agency_contract or '' }}</td>\r\n        </tr>\r\n        <tr class=\"highlight-row\">\r\n            <td><b>SC Code / PCC:</b></td>\r\n            <td>{{ doc.sc_code or '' }} / {{ doc.pcc or '' }}</td>\r\n            <td><b>Account Manager:</b></td>\r\n            <td>{{ doc.account_manager or '' }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><b>Contract Term:</b></td>\r\n            <td>{{ doc.term or '0' }} Months</td>\r\n            <td><b>Payment Cycle:</b></td>\r\n            <td>{{ doc.cycle or '' }} ({{ doc.payment_cycle or '0' }} Month)</td>\r\n        </tr>\r\n        <tr class=\"highlight-row\">\r\n            <td><b>Start - End Date:</b></td>\r\n            <td>{% if doc.start_date %}{{ frappe.utils.getdate(doc.start_date).strftime('%b/%Y') }}{% endif %} to {% if doc.end_date %}{{ frappe.utils.getdate(doc.end_date).strftime('%b/%Y') }}{% endif %}</td>\r\n            <td><b>Source / Target Segments:</b></td>\r\n            <td>{{ doc.source_type or '' }} | {{ doc.segments or 0 }} Segs</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Horizontal Calculation Period Breakdown -->\r\n    {% set total_row = doc.table_leve[-1] if doc.table_leve else None %}\r\n    <div class=\"section-header\">Measurement Calculation</div>\r\n    <table class=\"data-table\" style=\"margin-bottom: 5px; font-size: 9px;\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"min-width: 67px;\" class=\"text-left\">Booking</th>\r\n                {% for row in doc.table_leve %}\r\n                <th class=\"text-center {% if row.month == 'Total' %}bg-total{% endif %}\">\r\n                    {{ row.month }}\r\n                    {% if row.year %}<br><span style=\"font-size: 8px; color: #64748b; font-weight: normal;\">{{ row.year }}</span>{% endif %}\r\n                </th>\r\n                {% endfor %}\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">AIR</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.air or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">NDC</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.ndc or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.ms) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">MS</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.ms or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.np) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">NP</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.np or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.ne) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">NE</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.ne or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.ek) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">EK</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.ek or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.sv) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">SV</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.sv or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.group_a) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">GROUP A</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.group_a or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.group_b) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">GROUP B</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.group_b or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if total_row and frappe.utils.flt(total_row.group_c) != 0 %}\r\n            <tr>\r\n                <td class=\"text-left\" style=\"font-weight: bold; background-color: #f8fafc;\">GROUP C</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.group_c or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n            {% endif %}\r\n\r\n            <tr style=\"font-weight: bold;\">\r\n                <td class=\"text-left\" style=\"background-color: #e2e8f0;\">Total</td>\r\n                {% for row in doc.table_leve %}\r\n                <td class=\"{% if row.month == 'Total' %}bg-total{% endif %}\">{{ row.total or 0 }}</td>\r\n                {% endfor %}\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Incentive Tiers -->\r\n    <div class=\"section-header\">Incentive Tiers</div>\r\n    <table class=\"data-table\" style=\"margin-bottom: 5px;\">\r\n        <thead>\r\n            <tr>\r\n                <th class=\"text-left\">Type</th>\r\n                <th class=\"text-center\">From</th>\r\n                <th class=\"text-center\">To</th>\r\n                <th class=\"text-right\">Rate</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for row in doc.contract_measurements %}\r\n            <tr>\r\n                <td class=\"text-left\"><b>{{ row.tier_type }}</b></td>\r\n                <td class=\"text-center\">{{ row.from }}</td>\r\n                <td class=\"text-center\">{{ row.to }}</td>\r\n                <td class=\"text-right\">$ {{ \"%.2f\"|format(row.rate or 0) }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Total Value of the Segments -->\r\n    <div class=\"section-header\">Total Value of the Segments</div>\r\n    <div class=\"summary-container\">\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total AIR * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_air) }}</div>\r\n        </div>\r\n\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total NDC * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_ndc) }}</div>\r\n        </div>\r\n\r\n        {% if frappe.utils.flt(doc.total_ms) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total MS * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_ms) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_np) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total NP * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_np) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_ne) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total NE * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_ne) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_ek) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total EK * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_ek) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_sv) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total SV * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_sv) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_group_a) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total Group A * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_group_a) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_group_b) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total Group B * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_group_b) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        {% if frappe.utils.flt(doc.total_group_c) != 0 %}\r\n        <div class=\"summary-card\">\r\n            <div class=\"card-label\">Total Group C * Rate</div>\r\n            <div class=\"card-value\">$ {{ \"%.2f\"|format(doc.total_group_c) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <div class=\"summary-card\" style=\"background-color: #e0f2fe !important;\">\r\n            <div class=\"card-label\">Total Segments</div>\r\n            <div class=\"card-value\" style=\"color: #0369a1 !important;\">$ {{ \"%.2f\"|format(doc.total_segments) }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Payment Summary (Vertical Table) -->\r\n    <div class=\"section-header\">Payment Summary</div>\r\n    <table class=\"payment-summary-table\">\r\n        <tbody>\r\n            {% if frappe.utils.flt(doc.based_incentives) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Based Incentives</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.based_incentives) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.productivity_amount) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Productivity</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.productivity_amount) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.upfront) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Upfront</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.upfront) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.loyalty_bonus) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Loyalty Bonus</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.loyalty_bonus) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.line_of_credit) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Line Of Credit</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.line_of_credit) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.ek_a_option) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">EK A Option</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.ek_a_option) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.shortfall) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Shortfall</td>\r\n                <td class=\"value-col text-danger\">$ {{ \"%.2f\"|format(doc.shortfall) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.subtotal_usd) != 0 %}\r\n            <tr class=\"subtotal-row\">\r\n                <td class=\"label-col\">Subtotal USD</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.subtotal_usd) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.exception_payment) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Exception Payment</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.exception_payment) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.waived_shortfall) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Waived Shortfall</td>\r\n                <td class=\"value-col\">$ {{ \"%.2f\"|format(doc.waived_shortfall) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.paid) != 0 %}\r\n            <tr>\r\n                <td class=\"label-col\">Paid</td>\r\n                <td class=\"value-col text-danger\">$ {{ \"%.2f\"|format(doc.paid) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% if frappe.utils.flt(doc.total) != 0 %}\r\n            <tr class=\"total-row\">\r\n                <td class=\"label-col\" style=\"color: #ffffff;\">Total</td>\r\n                <td class=\"value-col\" style=\"color: #ffffff;\">$ {{ \"%.2f\"|format(doc.total) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Comments -->\r\n    {% if doc.comments %}\r\n    <div style=\"margin-top: 4px; padding: 4px; border: 1px solid #cbd5e1; color:red; background: #fafafa; border-radius: 2px\">\r\n        <b style=\"\"> Notes : {{ doc.comments }}</b>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align: center; margin-top: 6px; color: #94a3b8; font-size: 8px; padding-top: 3px;\">\r\n        Generated automatically via Sabre Financial System | Date: {{ frappe.utils.nowdate() }}\r\n    </div>\r\n</div>",
