  "html": "<div style=\"font-family: Arial; padding: 20px;\">\r\n    \r\n    <!-- Header -->\r\n    <div style=\"text-align: center; margin-bottom: 20px;\">\r\n        <h2 style=\"color: #2c3e50;\">Booking Incentive Measurement</h2>\r\n        <p style=\"color: #7f8c8d;\">{{ doc.name }} | {{ doc.measurement_date }}</p>\r\n    </div>\r\n\r\n    <!-- Contract Info -->\r\n    <div style=\"background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Contract Information</h4>\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\"><b>Agency:</b> {{ doc.agency_name }}</td>\r\n                <td width=\"50%\"><b>Contract:</b> {{ doc.contract }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Account Manager:</b> {{ doc.account_manager }}</td>\r\n                <td><b>Measurement Date:</b> {{ doc.measurement_date }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>From Date:</b> {{ doc.from_date }}</td>\r\n                <td><b>To Date:</b> {{ doc.to_date }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Segments -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Segments</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr style=\"background: #2c3e50; color: white;\">\r\n                <th style=\"padding: 8px;\">Type</th>\r\n                <th style=\"padding: 8px;\">AIR</th>\r\n                <th style=\"padding: 8px;\">NDC</th>\r\n                <th style=\"padding: 8px;\">Total</th>\r\n            </tr>\r\n            <tr style=\"text-align: center;\">\r\n                <td style=\"padding: 8px;\"><b>Segments</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.total_air }}</td>\r\n                <td style=\"padding: 8px;\">{{ doc.total_ndc }}</td>\r\n                <td style=\"padding: 8px;\"><b>{{ doc.total_segments }}</b></td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Payment Summary -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Payment Summary</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr>\r\n                <td style=\"padding: 8px; width: 70%;\">Based Incentives</td>\r\n                <td style=\"padding: 8px; text-align: right;\">$ {{ doc.based_incentives }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Upfront</td>\r\n                <td style=\"padding: 8px; text-align: right;\">$ {{ doc.upfront }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Shortfall</td>\r\n                <td style=\"padding: 8px; text-align: right;\">$ {{ doc.shortfall }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">EK-A Option</td>\r\n                <td style=\"padding: 8px; text-align: right;\">$ {{ doc.ek_a_option }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Subtotal USD</td>\r\n                <td style=\"padding: 8px; text-align: right;\">$ {{ doc.subtotal_usd }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\">Paid</td>\r\n                <td style=\"padding: 8px; text-align: right;\">$ {{ doc.paid }}</td>\r\n            </tr>\r\n            <tr style=\"background: #2c3e50; color: white;\">\r\n                <td style=\"padding: 8px;\"><b>Total</b></td>\r\n                <td style=\"padding: 8px; text-align: right;\"><b>$ {{ doc.total }}</b></td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Comments -->\r\n    {% if doc.comments %}\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Comments</h4>\r\n        <p>{{ doc.comments }}</p>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align: center; margin-top: 30px; color: #7f8c8d; font-size: 12px;\">\r\n        <p>Generated by Sabre Finance System</p>\r\n    </div>\r\n\r\n</div>",
