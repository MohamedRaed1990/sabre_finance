  "html": "<div style=\"font-family: Arial; padding: 20px;\">\r\n\r\n    <!-- Header -->\r\n    <div style=\"text-align: center; margin-bottom: 20px;\">\r\n        <h2 style=\"color: #2c3e50;\">Frontline Incentive</h2>\r\n        <p style=\"color: #7f8c8d;\">{{ doc.name }} | {{ doc.quarter }} {{ doc.year }}</p>\r\n    </div>\r\n\r\n    <!-- Agency Info -->\r\n    <div style=\"background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Agency Information</h4>\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\"><b>Agency:</b> {{ doc.agency_name }}</td>\r\n                <td width=\"50%\"><b>Agent Name:</b> {{ doc.agent_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Account Manager:</b> {{ doc.account_manager }}</td>\r\n                <td><b>Quarter:</b> {{ doc.quarter }} {{ doc.year }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Incentive Details -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Incentive Details</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr style=\"background: #2c3e50; color: white;\">\r\n                <th style=\"padding: 8px;\">Total Segments</th>\r\n                <th style=\"padding: 8px;\">Rate</th>\r\n                <th style=\"padding: 8px;\">Total USD</th>\r\n            </tr>\r\n            <tr style=\"text-align: center;\">\r\n                <td style=\"padding: 8px;\">{{ doc.total_segments }}</td>\r\n                <td style=\"padding: 8px;\">{{ doc.rate }}</td>\r\n                <td style=\"padding: 8px;\"><b>$ {{ doc.total_usd }}</b></td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Payment Details -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Payment Details</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr>\r\n                <td style=\"padding: 8px; width: 50%\"><b>Payment Mode:</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.payment_mode }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\"><b>Finance Status:</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.finance_status }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\"><b>Claim and Invoice:</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.claim_and_invoice }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px;\"><b>Transfer:</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.transfer }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    {% if doc.neveen_comments %}\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Comments</h4>\r\n        <p>{{ doc.neveen_comments }}</p>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align: center; margin-top: 30px; color: #7f8c8d; font-size: 12px;\">\r\n        <p>Generated by Sabre Finance System</p>\r\n    </div>\r\n\r\n</div>",
