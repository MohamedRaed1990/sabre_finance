  "html": "<div style=\"font-family: Arial; padding: 20px;\">\r\n\r\n    <!-- Header -->\r\n    <div style=\"text-align: center; margin-bottom: 20px;\">\r\n        <h2 style=\"color: #2c3e50;\">Segment Report</h2>\r\n        <p style=\"color: #7f8c8d;\">{{ doc.name }} | {{ doc.report_month }} {{ doc.report_year }}</p>\r\n    </div>\r\n\r\n    <!-- Agency Info -->\r\n    <div style=\"background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Agency Information</h4>\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\"><b>Agency:</b> {{ doc.agency }}</td>\r\n                <td width=\"50%\"><b>Agency Name:</b> {{ doc.agency_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Account Manager:</b> {{ doc.account_manager }}</td>\r\n                <td><b>Period:</b> {{ doc.report_month }} {{ doc.report_year }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Segments Data -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Segments Data</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr style=\"background: #2c3e50; color: white;\">\r\n                <th style=\"padding: 8px;\">Source</th>\r\n                <th style=\"padding: 8px;\">AIR</th>\r\n                <th style=\"padding: 8px;\">NDC</th>\r\n                <th style=\"padding: 8px;\">Total</th>\r\n            </tr>\r\n            <tr style=\"text-align: center;\">\r\n                <td style=\"padding: 8px;\"><b>Todd</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.todd_air }}</td>\r\n                <td style=\"padding: 8px;\">{{ doc.todd_ndc }}</td>\r\n                <td style=\"padding: 8px;\">{{ (doc.todd_air or 0) + (doc.todd_ndc or 0) }}</td>\r\n            </tr>\r\n            <tr style=\"text-align: center; background: #f8f9fa;\">\r\n                <td style=\"padding: 8px;\"><b>Sabre</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.sabre_air }}</td>\r\n                <td style=\"padding: 8px;\">{{ doc.sabre_ndc }}</td>\r\n                <td style=\"padding: 8px;\">{{ (doc.sabre_air or 0) + (doc.sabre_ndc or 0) }}</td>\r\n            </tr>\r\n            <tr style=\"text-align: center;\">\r\n                <td style=\"padding: 8px;\"><b>MIDT</b></td>\r\n                <td style=\"padding: 8px;\">{{ doc.midt_air }}</td>\r\n                <td style=\"padding: 8px;\">{{ doc.midt_ndc }}</td>\r\n                <td style=\"padding: 8px;\">{{ (doc.midt_air or 0) + (doc.midt_ndc or 0) }}</td>\r\n            </tr>\r\n            <tr style=\"background: #2c3e50; color: white; text-align: center;\">\r\n                <td style=\"padding: 8px;\"><b>Total</b></td>\r\n                <td style=\"padding: 8px;\"><b>{{ (doc.todd_air or 0) + (doc.sabre_air or 0) + (doc.midt_air or 0) }}</b></td>\r\n                <td style=\"padding: 8px;\"><b>{{ (doc.todd_ndc or 0) + (doc.sabre_ndc or 0) + (doc.midt_ndc or 0) }}</b></td>\r\n                <td style=\"padding: 8px;\"><b>{{ (doc.todd_air or 0) + (doc.sabre_air or 0) + (doc.midt_air or 0) + (doc.todd_ndc or 0) + (doc.sabre_ndc or 0) + (doc.midt_ndc or 0) }}</b></td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align: center; margin-top: 30px; color: #7f8c8d; font-size: 12px;\">\r\n        <p>Generated by Sabre Finance System</p>\r\n    </div>\r\n\r\n</div>",
