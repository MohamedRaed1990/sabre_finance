  "html": "<div style=\"font-family: Arial; padding: 20px;\">\r\n\r\n    <!-- Header -->\r\n    <div style=\"text-align: center; margin-bottom: 30px;\">\r\n        <h2 style=\"color: #2c3e50;\">Agency Contract</h2>\r\n        <p style=\"color: #7f8c8d;\">{{ doc.name }} | {{ doc.contract }}</p>\r\n    </div>\r\n\r\n    <!-- Contract Details -->\r\n    <div style=\"background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Contract Details</h4>\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\"><b>PCC Code:</b> {{ doc.pcc_code }}</td>\r\n                <td width=\"50%\"><b>Agency Name:</b> {{ doc.agency_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Contract:</b> {{ doc.contract }}</td>\r\n                <td><b>Account Manager:</b> {{ doc.account_manager }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Start Date:</b> {{ doc.start_date }}</td>\r\n                <td><b>End Date:</b> {{ doc.end_date }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Term (Months):</b> {{ doc.term_months }}</td>\r\n                <td><b>Payment Cycle:</b> {{ doc.payment_cycle }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Due Date:</b> {{ doc.due_date }}</td>\r\n                <td><b>Payment Due Month:</b> {{ doc.payment_due_month }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Incentive Tiers -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Incentive Tiers</h4>\r\n        <table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\r\n            <tr style=\"background: #2c3e50; color: white;\">\r\n                <th style=\"padding: 8px;\">Tier Type</th>\r\n                <th style=\"padding: 8px;\">From</th>\r\n                <th style=\"padding: 8px;\">To</th>\r\n                <th style=\"padding: 8px;\">Rate</th>\r\n            </tr>\r\n            {% for tier in doc.tiers %}\r\n            <tr style=\"text-align: center;\">\r\n                <td style=\"padding: 8px;\">{{ tier.tier_type }}</td>\r\n                <td style=\"padding: 8px;\">{{ tier.get(\"from\") }}</td>\r\n                <td style=\"padding: 8px;\">{{ tier.to }}</td>\r\n                <td style=\"padding: 8px;\">$ {{ tier.rate }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Payment Info -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <h4 style=\"color: #2c3e50; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;\">Payment Info</h4>\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\"><b>Second Due Month:</b> {{ doc.second_due_month }}</td>\r\n            </tr>\r\n            {% if doc.notes %}\r\n            <tr>\r\n                <td colspan=\"2\"><b>Notes:</b> {{ doc.notes }}</td>\r\n            </tr>\r\n            {% endif %}\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Signatures -->\r\n    <div style=\"margin-top: 50px;\">\r\n        <table width=\"100%\">\r\n            <tr>\r\n                <td width=\"50%\" style=\"text-align: center;\">\r\n                    <div style=\"border-top: 1px solid #2c3e50; padding-top: 5px; margin: 0 20px;\">\r\n                        <p>Authorized Signature</p>\r\n                    </div>\r\n                </td>\r\n                <td width=\"50%\" style=\"text-align: center;\">\r\n                    <div style=\"border-top: 1px solid #2c3e50; padding-top: 5px; margin: 0 20px;\">\r\n                        <p>Agency Signature</p>\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align: center; margin-top: 30px; color: #7f8c8d; font-size: 12px;\">\r\n        <p>Generated by Sabre Finance System</p>\r\n    </div>\r\n\r\n</div>",
